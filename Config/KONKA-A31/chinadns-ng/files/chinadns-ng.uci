config chinadns-ng 'main'
    option enable '1'
    option bind_addr '127.0.0.1'
    option bind_port '5335'
    option china_dns 'udp://211.83.192.28,221.5.203.98,udp://2402:4e00::'
    option trust_dns 'tls://dns.alidns.com@223.5.5.5?count=0?life=300,tls://dns.alidns.com@2400:3200::1?count=0?life=300'
    option chnlist_file '/etc/chinadns-ng/chinalist.txt'
    option gfwlist_file '/etc/chinadns-ng/gfwlist.txt'
    option default_tag 'gfw'
    option chnlist_first '1'
    option timeout_sec '3'
    option cache_size '4096'
    option cert_verify '1'
