#!/bin/sh /etc/rc.common
START=50
STOP=89
USE_PROCD=1
PROG=/usr/bin/chinadns-ng

start_instance() {
    local section="$1" enable bind_addr bind_port china_dns trust_dns chnlist_file gfwlist_file
    local timeout_sec cache_size default_tag cert_verify chnlist_first
    config_get_bool enable "$section" enable 1
    [ "$enable" = 1 ] || return 0
    config_get bind_addr "$section" bind_addr '127.0.0.1'
    config_get bind_port "$section" bind_port '5335'
    config_get china_dns "$section" china_dns
    config_get trust_dns "$section" trust_dns
    config_get chnlist_file "$section" chnlist_file '/etc/chinadns-ng/chinalist.txt'
    config_get gfwlist_file "$section" gfwlist_file '/etc/chinadns-ng/gfwlist.txt'
    config_get timeout_sec "$section" timeout_sec '3'
    config_get cache_size "$section" cache_size '4096'
    config_get default_tag "$section" default_tag 'gfw'
    config_get_bool cert_verify "$section" cert_verify 1
    config_get_bool chnlist_first "$section" chnlist_first 1
    [ -x "$PROG" ] && [ -s "$chnlist_file" ] || return 1
    procd_open_instance "$section"
    procd_set_param command "$PROG" -b "$bind_addr" -l "$bind_port" \
        -c "$china_dns" -t "$trust_dns" -d "$default_tag" -o "$timeout_sec" \
        --cache "$cache_size" --cache-refresh 20
    procd_append_param command -m "$chnlist_file"
    [ ! -s "$gfwlist_file" ] || procd_append_param command -g "$gfwlist_file"
    [ "$chnlist_first" != 1 ] || procd_append_param command -M
    if [ "$cert_verify" = 1 ]; then
        procd_append_param command --cert-verify --ca-certs /etc/ssl/certs/ca-certificates.crt
    fi
    procd_set_param file /etc/config/chinadns-ng "$chnlist_file" "$gfwlist_file"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_service() {
    config_load 'chinadns-ng'
    config_foreach start_instance 'chinadns-ng'
}
reload_service() { stop; start; }
service_triggers() { procd_add_reload_trigger 'chinadns-ng'; }
